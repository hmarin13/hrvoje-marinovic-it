---
const linkedinUrl =
	'https://www.linkedin.com/in/hrvoje-marinovi%C4%87-8408b1211/';
---

<header>
	<nav aria-label="Glavna navigacija">
		<a
			class="brand"
			href="/"
			aria-label="Hrvoje Marinović, početna stranica"
		>
			<span class="brand-photo-wrapper">
				<img
					class="brand-photo"
					src="/hrvoje-marinovic.jpg"
					alt=""
					width="96"
					height="96"
				/>
			</span>

			<span class="brand-text">
				<strong>Hrvoje Marinović</strong>
				<small>Microsoft 365 & Endpoint Security</small>
			</span>
		</a>

		<div class="internal-links">
			<a href="/">Početna</a>
			<a href="/#usluge">Usluge</a>
			<a href="/#projekti">Projekti</a>
			<a href="/#o-meni">O meni</a>
			<a href="/blog">Blog</a>
		</div>

		<div class="header-actions">
			<a
				class="linkedin-link"
				href={linkedinUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="LinkedIn profil Hrvoja Marinovića"
			>
				<span aria-hidden="true">in</span>
			</a>

			<a class="contact-button" href="/#kontakt">
				Kontakt
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 1000;
		margin: 0;
		border-bottom: 1px solid rgba(226, 232, 240, 0.9);
		background: rgba(255, 255, 255, 0.94);
		box-shadow: 0 4px 24px rgba(15, 23, 42, 0.04);
		backdrop-filter: blur(16px);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(1180px, calc(100% - 40px));
		min-height: 78px;
		margin-inline: auto;
		gap: 28px;
	}

	.brand {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		gap: 13px;
		color: #0f172a;
		text-decoration: none;
	}

	.brand-photo-wrapper {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		padding: 3px;
		border-radius: 50%;
		background: linear-gradient(135deg, #2563eb, #60a5fa);
		box-shadow: 0 8px 22px rgba(37, 99, 235, 0.25);
	}

	.brand-photo {
		display: block;
		width: 100%;
		height: 100%;
		border: 2px solid #ffffff;
		border-radius: 50%;
		background: #e2e8f0;
		object-fit: cover;
		object-position: center;
	}

	.brand-text {
		display: grid;
		gap: 3px;
	}

	.brand-text strong {
		color: #0f172a;
		font-size: 1rem;
		font-weight: 800;
		line-height: 1.2;
	}

	.brand-text small {
		color: #64748b;
		font-size: 0.7rem;
		font-weight: 650;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}

	.internal-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
	}

	.internal-links a {
		padding: 10px 11px;
		border-radius: 9px;
		color: #334155;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			color 160ms ease,
			background-color 160ms ease;
	}

	.internal-links a:hover,
	.internal-links a:focus-visible {
		background: #eff6ff;
		color: #1d4ed8;
	}

	.header-actions {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		gap: 10px;
	}

	.linkedin-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border: 1px solid #cbd5e1;
		border-radius: 10px;
		background: #ffffff;
		color: #0a66c2;
		font-family: Arial, sans-serif;
		font-size: 1rem;
		font-weight: 900;
		text-decoration: none;
		transition:
			transform 160ms ease,
			border-color 160ms ease,
			background-color 160ms ease;
	}

	.linkedin-link:hover,
	.linkedin-link:focus-visible {
		transform: translateY(-1px);
		border-color: #93c5fd;
		background: #eff6ff;
	}

	.contact-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 40px;
		padding: 9px 16px;
		border-radius: 10px;
		background: #2563eb;
		box-shadow: 0 8px 20px rgba(37, 99, 235, 0.2);
		color: #ffffff;
		font-size: 0.88rem;
		font-weight: 800;
		text-decoration: none;
		transition:
			transform 160ms ease,
			background-color 160ms ease;
	}

	.contact-button:hover,
	.contact-button:focus-visible {
		transform: translateY(-1px);
		background: #1d4ed8;
	}

	a:focus-visible {
		outline: 3px solid rgba(37, 99, 235, 0.3);
		outline-offset: 3px;
	}

	@media (max-width: 940px) {
		nav {
			flex-wrap: wrap;
			padding-block: 12px;
		}

		.internal-links {
			order: 3;
			width: 100%;
			justify-content: flex-start;
			overflow-x: auto;
			padding-top: 6px;
			scrollbar-width: thin;
		}

		.internal-links a {
			white-space: nowrap;
		}
	}

	@media (max-width: 600px) {
		nav {
			width: min(100% - 28px, 1180px);
			gap: 12px;
		}

		.brand-photo-wrapper {
			width: 42px;
			height: 42px;
		}

		.brand-text strong {
			font-size: 0.92rem;
		}

		.brand-text small {
			display: none;
		}

		.linkedin-link {
			display: none;
		}

		.contact-button {
			padding-inline: 13px;
		}
	}

	@media (max-width: 390px) {
		.brand-text strong {
			max-width: 115px;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.contact-button {
			font-size: 0.8rem;
		}
	}
</style>
