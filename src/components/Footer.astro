---
const currentYear = new Date().getFullYear();

const linkedinUrl =
	'https://www.linkedin.com/in/hrvoje-marinovi%C4%87-8408b1211/';
---

<footer>
	<div class="footer-container">
		<div class="footer-brand">
			<a class="brand" href="/" aria-label="Hrvoje Marinović, početna stranica">
		<span class="brand-photo-wrapper">
	<img
		class="brand-photo"
		src="/hrvoje-marinovic.jpg"
		alt=""
		width="48"
		height="48"
		loading="lazy"
	/>
</span>
			</a>

			<p>
				Standardizacija, automatizacija i sigurnosno unaprjeđenje
				Microsoft 365 i Windows okruženja.
			</p>
		</div>

		<div class="footer-column">
			<strong>Navigacija</strong>

			<nav aria-label="Navigacija u podnožju">
				<a href="/">Početna</a>
				<a href="/#usluge">Usluge</a>
				<a href="/#projekti">Projekti</a>
				<a href="/#o-meni">O meni</a>
				<a href="/blog">Blog</a>
			</nav>
		</div>

		<div class="footer-column">
			<strong>Kontakt</strong>

			<div class="footer-links">
				<a href="mailto:hmarin13@gmail.com">
					hmarin13@gmail.com
				</a>

				<a
					href={linkedinUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					LinkedIn profil
				</a>
			</div>
		</div>
	</div>

	<div class="footer-bottom">
		<p>© {currentYear} Hrvoje Marinović. Sva prava pridržana.</p>

		<a href="/politika-privatnosti">
			Politika privatnosti
		</a>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid #1e293b;
		background: #0f172a;
		color: #ffffff;
	}

	.footer-container {
		display: grid;
		grid-template-columns: 1.5fr 0.7fr 0.8fr;
		gap: 60px;
		width: min(1180px, calc(100% - 40px));
		margin-inline: auto;
		padding-block: 62px;
	}

	.footer-brand {
		max-width: 480px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: #ffffff;
		text-decoration: none;
	}

.brand-photo-wrapper {
	display: inline-flex;
	flex-shrink: 0;
	align-items: center;
	justify-content: center;
	width: 48px;
	height: 48px;
	padding: 3px;
	border-radius: 50%;
	background: linear-gradient(135deg, #2563eb, #60a5fa);
	box-shadow: 0 8px 22px rgba(37, 99, 235, 0.25);
}

.brand-photo {
	display: block;
	width: 100%;
	height: 100%;
	border: 2px solid #ffffff;
	border-radius: 50%;
	background: #1e293b;
	object-fit: cover;
	object-position: center;
}

	.brand-text {
		display: grid;
		gap: 3px;
	}

	.brand-text strong {
		font-size: 1rem;
	}

	.brand-text small {
		color: #94a3b8;
		font-size: 0.72rem;
	}

	.footer-brand p {
		max-width: 440px;
		margin: 24px 0 0;
		color: #94a3b8;
		line-height: 1.7;
	}

	.footer-column {
		display: grid;
		align-content: start;
		gap: 20px;
	}

	.footer-column > strong {
		color: #ffffff;
		font-size: 0.85rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.footer-column nav,
	.footer-links {
		display: grid;
		gap: 12px;
	}

	.footer-column a,
	.footer-bottom a {
		color: #cbd5e1;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.footer-column a:hover,
	.footer-column a:focus-visible,
	.footer-bottom a:hover,
	.footer-bottom a:focus-visible {
		color: #60a5fa;
	}

	.footer-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		width: min(1180px, calc(100% - 40px));
		margin-inline: auto;
		padding-block: 24px;
		border-top: 1px solid rgba(148, 163, 184, 0.18);
	}

	.footer-bottom p {
		margin: 0;
		color: #94a3b8;
		font-size: 0.86rem;
	}

	.footer-bottom a {
		font-size: 0.86rem;
	}

	a:focus-visible {
		outline: 3px solid rgba(96, 165, 250, 0.45);
		outline-offset: 4px;
	}

	@media (max-width: 800px) {
		.footer-container {
			grid-template-columns: 1fr 1fr;
		}

		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 560px) {
		.footer-container {
			grid-template-columns: 1fr;
			gap: 38px;
			width: min(100% - 28px, 1180px);
			padding-block: 46px;
		}

		.footer-brand {
			grid-column: auto;
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
			width: min(100% - 28px, 1180px);
		}
	}
</style>
