---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="hr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<div class="hero-content">
					<p class="eyebrow">
						MICROSOFT 365 • INTUNE • AUTOPILOT • INFORMACIJSKA SIGURNOST
					</p>

					<h1>
						Sigurnije i jednostavnije upravljanje
						<span>Microsoft 365 i Windows okruženjem</span>
					</h1>

					<p class="hero-text">
						Pomažem tvrtkama, uredima, školama, fakultetima te javnim i
						privatnim ustanovama automatizirati pripremu uređaja,
						standardizirati konfiguracije i unaprijediti sigurnost
						informacijskog sustava.
					</p>

					<div class="hero-actions">
						<a class="button primary" href="#usluge">
							Pogledajte usluge
						</a>

						<a class="button secondary" href="#kontakt">
							Pošaljite upit
						</a>
					</div>

					<div
						class="technology-list"
						aria-label="Područja specijalizacije"
					>
						<span>Microsoft 365</span>
						<span>Microsoft Intune</span>
						<span>Windows Autopilot</span>
						<span>Microsoft Entra ID</span>
						<span>Defender for Endpoint</span>
					</div>
				</div>

				<aside class="hero-card">
					<p class="card-label">Cilj implementacije</p>

					<h2>Računalo spremno za siguran rad</h2>

					<ul>
						<li>Automatizirana priprema uređaja</li>
						<li>Standardizirane konfiguracije</li>
						<li>Centralizirana instalacija aplikacija</li>
						<li>Sigurnosne politike i ažuriranja</li>
						<li>Dokumentirano i održivo rješenje</li>
					</ul>
				</aside>
			</section>

			<section
				class="section intro"
				aria-labelledby="intro-title"
			>
				<div>
					<p class="section-label">MODERNO IT OKRUŽENJE</p>

					<h2 id="intro-title">
						Manje ručnog rada, više kontrole i sigurnosti
					</h2>
				</div>

				<p>
					Ako vaša organizacija koristi Microsoft 365, ali računala još
					uvijek priprema ručno, moguće je centralizirati upravljanje
					uređajima, aplikacijama, ažuriranjima, korisničkim pristupom i
					sigurnosnim postavkama.
				</p>
			</section>

			<section id="usluge" class="section">
				<div class="section-heading">
					<p class="section-label">USLUGE</p>

					<h2>Rješenja prilagođena vašoj organizaciji</h2>

					<p>
						Od analize postojećeg stanja do implementacije, testiranja,
						dokumentiranja i daljnje podrške.
					</p>
				</div>

				<div class="services-grid">
					<article class="service-card">
						<div class="service-number">01</div>

						<h3>Microsoft 365 procjena</h3>

						<p>
							Pregled korisnika, grupa, licenci, administratorskih uloga,
							pristupa i postojećih sigurnosnih postavki.
						</p>
					</article>

					<article class="service-card">
						<div class="service-number">02</div>

						<h3>Microsoft Intune</h3>

						<p>
							Centralizirano upravljanje Windows uređajima, aplikacijama,
							konfiguracijama, ažuriranjima i sigurnosnim pravilima.
						</p>
					</article>

					<article class="service-card">
						<div class="service-number">03</div>

						<h3>Windows Autopilot</h3>

						<p>
							Automatizirana priprema novih računala bez dugotrajne ručne
							instalacije i pojedinačnog konfiguriranja.
						</p>
					</article>

					<article class="service-card">
						<div class="service-number">04</div>

						<h3>Identitet i pristup</h3>

						<p>
							Microsoft Entra ID, korisnički računi, grupe, MFA,
							pristupne ovlasti i pravila uvjetnog pristupa.
						</p>
					</article>

					<article class="service-card">
						<div class="service-number">05</div>

						<h3>Endpoint sigurnost</h3>

						<p>
							Microsoft Defender for Endpoint, sigurnosna pravila,
							usklađenost uređaja i zaštita korisničkih računa.
						</p>
					</article>

					<article class="service-card">
						<div class="service-number">06</div>

						<h3>Dokumentacija i podrška</h3>

						<p>
							Administratorske upute, evidencija konfiguracija,
							preporuke, edukacija i podrška pri održavanju sustava.
						</p>
					</article>
				</div>
			</section>

			<section id="projekti" class="section projects-section">
				<div class="section-heading">
					<p class="section-label">PROJEKTI</p>

					<h2>Praktična rješenja i područja rada</h2>

					<p>
						Primjeri implementacija i usluga koje se mogu prilagoditi
						veličini, licencama i načinu rada organizacije.
					</p>
				</div>

				<div class="projects-grid">
					<article class="project-card featured">
						<p class="project-type">ENDPOINT MANAGEMENT</p>

						<h3>
							Automatizirana priprema i standardizacija uređaja
						</h3>

						<p>
							Implementacija sustava Microsoft Intune i Windows Autopilot
							za automatizirani upis uređaja, dodjelu aplikacija,
							sigurnosnih postavki i pravila ažuriranja.
						</p>

						<div class="tags">
							<span>Intune</span>
							<span>Autopilot</span>
							<span>Windows 11</span>
						</div>
					</article>

					<article class="project-card">
						<p class="project-type">INFORMACIJSKA SIGURNOST</p>

						<h3>Standardizacija sigurnosnih politika</h3>

						<p>
							Uspostava centraliziranih konfiguracijskih i sigurnosnih
							pravila, usklađenosti uređaja, MFA zaštite i upravljanja
							pristupom.
						</p>

						<div class="tags">
							<span>Entra ID</span>
							<span>MFA</span>
							<span>Defender</span>
						</div>
					</article>

					<article class="project-card">
						<p class="project-type">AUTOMATIZACIJA</p>

						<h3>Aplikacije i Windows ažuriranja</h3>

						<p>
							Centralizirana distribucija poslovnih aplikacija,
							definiranje ciljnih grupa te upravljanje pravilima i
							rokovima ažuriranja.
						</p>

						<div class="tags">
							<span>Win32 Apps</span>
							<span>Updates</span>
							<span>Automation</span>
						</div>
					</article>
				</div>
			</section>

			<section id="ai" class="section ai-section">
				<div class="ai-content">
					<p class="section-label light">
						AI PROJEKTI I AUTOMATIZACIJA
					</p>

					<h2>Praktični projekti i rješenja u razvoju</h2>

					<p>
						Istražujem praktičnu primjenu umjetne inteligencije i
						automatizacije u IT administraciji, obradi dokumentacije,
						izradi izvještaja i internim bazama znanja. U ovom dijelu
						predstavljat ću demonstracijske projekte i testna rješenja
						izrađena korištenjem sintetičkih ili anonimiziranih podataka.
					</p>

					<div class="ai-items">
						<span>AI demonstracijski projekti</span>
						<span>IT dokumentacija</span>
						<span>Interne baze znanja</span>
						<span>Automatizacija procesa</span>
					</div>
				</div>
			</section>

			<section id="o-meni" class="section about-section">
				<div class="about-card">
					<div class="about-photo-wrapper">
						<img
							class="about-photo"
							src="/hrvoje-marinovic.jpg"
							alt="Profesionalna fotografija autora web-stranice"
							width="600"
							height="600"
							loading="lazy"
						/>
					</div>

					<div class="about-content">
						<p class="section-label">O MENI</p>

						<h2>Hrvoje Marinović</h2>

						<p class="about-lead">
							Volim složene IT sustave pretvoriti u standardizirano,
							sigurno i jednostavnije okruženje za korisnike i
							administratore.
						</p>

						<p>
							IT stručnjak usmjeren na Microsoft 365, Microsoft Intune,
							Windows Autopilot, Microsoft Entra ID i informacijsku
							sigurnost. Iskustvo obuhvaća administraciju korisnika,
							uređaja, informacijskih sustava, mreža i sigurnosnih
							rješenja.
						</p>

						<p>
							Završio sam stručni diplomski studij Informacijska
							sigurnost i digitalna forenzika, a Microsoft Intune i
							Windows Autopilot bili su područje mojeg diplomskog rada
							i praktične implementacije.
						</p>

						<div class="credentials">
							<div>
								<strong>mag. ing. inf. sig.</strong>

								<span>
									Informacijska sigurnost i digitalna forenzika
								</span>
							</div>

							<div>
								<strong>Network Security</strong>

								<span>Cisco Networking Academy</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section id="kontakt" class="section contact-section">
				<div>
					<p class="section-label">KONTAKT</p>

					<h2>Razgovarajmo o vašem IT okruženju</h2>

					<p>
						Opišite trenutačno stanje, broj korisnika i uređaja te što
						želite standardizirati, automatizirati ili sigurnosno
						unaprijediti.
					</p>
				</div>

				<div class="contact-actions">
					<a
						class="button primary"
						href="mailto:hmarin13@gmail.com"
					>
						Pošaljite e-mail
					</a>

					<a
						class="button secondary"
						href="https://www.linkedin.com/in/hrvoje-marinovi%C4%87-8408b1211/"
						target="_blank"
						rel="noopener noreferrer"
					>
						LinkedIn profil
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		scroll-padding-top: 110px;
	}

	:global(body) {
		margin: 0;
		background:
			radial-gradient(
				circle at 85% 5%,
				rgba(37, 99, 235, 0.12),
				transparent 28rem
			),
			#f8fafc;
		color: #0f172a;
		font-family:
			Inter,
			ui-sans-serif,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
	}

	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}

	.hero,
	.section {
		width: min(1180px, calc(100% - 40px));
		margin-inline: auto;
	}

	.hero {
		display: grid;
		grid-template-columns:
			minmax(0, 1.35fr)
			minmax(290px, 0.65fr);
		gap: 64px;
		align-items: center;
		min-height: 720px;
		padding-block: 96px;
	}

	.eyebrow,
	.section-label,
	.project-type,
	.card-label {
		margin: 0 0 18px;
		color: #2563eb;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 850px;
		margin-bottom: 28px;
		font-size: clamp(2.7rem, 6vw, 5.7rem);
		line-height: 0.98;
		letter-spacing: -0.055em;
	}

	h1 span {
		display: block;
		color: #2563eb;
	}

	h2 {
		font-size: clamp(2rem, 4vw, 3.4rem);
		line-height: 1.08;
		letter-spacing: -0.04em;
	}

	h3 {
		font-size: 1.35rem;
		line-height: 1.25;
	}

	p {
		color: #475569;
		line-height: 1.75;
	}

	.hero-text {
		max-width: 760px;
		margin-bottom: 34px;
		font-size: 1.13rem;
	}

	.hero-actions,
	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 50px;
		padding: 12px 22px;
		border-radius: 12px;
		font-weight: 750;
		text-decoration: none;
		transition:
			transform 160ms ease,
			box-shadow 160ms ease,
			background-color 160ms ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.button.primary {
		background: #2563eb;
		box-shadow: 0 12px 28px rgba(37, 99, 235, 0.24);
		color: #ffffff;
	}

	.button.primary:hover {
		background: #1d4ed8;
	}

	.button.secondary {
		border: 1px solid #cbd5e1;
		background: rgba(255, 255, 255, 0.8);
		color: #0f172a;
	}

	.technology-list,
	.tags,
	.ai-items {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.technology-list {
		margin-top: 34px;
	}

	.technology-list span,
	.tags span,
	.ai-items span {
		border: 1px solid #dbeafe;
		border-radius: 999px;
		background: #eff6ff;
		color: #1d4ed8;
		font-size: 0.84rem;
		font-weight: 700;
		padding: 8px 12px;
	}

	.hero-card {
		padding: 34px;
		border: 1px solid rgba(148, 163, 184, 0.28);
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.86);
		box-shadow: 0 24px 70px rgba(15, 23, 42, 0.12);
		backdrop-filter: blur(14px);
	}

	.hero-card h2 {
		margin-bottom: 26px;
		font-size: 1.75rem;
	}

	.hero-card ul {
		display: grid;
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.hero-card li {
		position: relative;
		padding-left: 28px;
		color: #334155;
		line-height: 1.55;
	}

	.hero-card li::before {
		position: absolute;
		top: 0;
		left: 0;
		color: #16a34a;
		font-weight: 900;
		content: "✓";
	}

	.section {
		padding-block: 90px;
	}

	.intro {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 70px;
		align-items: end;
		border-top: 1px solid #e2e8f0;
		border-bottom: 1px solid #e2e8f0;
	}

	.intro h2,
	.section-heading h2,
	.about-card h2,
	.contact-section h2 {
		margin-bottom: 20px;
	}

	.intro > p {
		font-size: 1.08rem;
	}

	.section-heading {
		max-width: 730px;
		margin-bottom: 42px;
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.service-card,
	.project-card,
	.about-card {
		border: 1px solid #e2e8f0;
		border-radius: 20px;
		background: #ffffff;
		box-shadow: 0 10px 35px rgba(15, 23, 42, 0.05);
	}

	.service-card {
		padding: 28px;
	}

	.service-number {
		margin-bottom: 30px;
		color: #2563eb;
		font-size: 0.82rem;
		font-weight: 900;
	}

	.service-card p,
	.project-card p {
		margin-bottom: 0;
	}

	.projects-section {
		padding-top: 110px;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 22px;
	}

	.project-card {
		padding: 32px;
	}

	.project-card.featured {
		grid-row: span 2;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 470px;
		background: linear-gradient(
			145deg,
			rgba(15, 23, 42, 0.98),
			rgba(30, 64, 175, 0.94)
		);
		color: #ffffff;
	}

	.project-card.featured h3 {
		color: #ffffff;
	}

	.project-card.featured .project-type {
		color: #93c5fd;
	}

	.project-card.featured p {
		color: #dbeafe;
	}

	.project-card.featured .tags span {
		border-color: rgba(147, 197, 253, 0.25);
		background: rgba(37, 99, 235, 0.18);
		color: #dbeafe;
	}

	.ai-section {
		width: min(1180px, calc(100% - 40px));
		padding: 70px;
		border-radius: 28px;
		background:
			radial-gradient(
				circle at 90% 20%,
				rgba(59, 130, 246, 0.5),
				transparent 30rem
			),
			#0f172a;
		color: #ffffff;
	}

	.ai-content {
		max-width: 800px;
	}

	.ai-section h2 {
		margin-bottom: 22px;
		color: #ffffff;
	}

	.ai-section .section-label {
		color: #93c5fd;
	}

	.ai-section p {
		color: #cbd5e1;
	}

	.ai-items {
		margin-top: 28px;
	}

	.ai-items span {
		border-color: rgba(147, 197, 253, 0.25);
		background: rgba(37, 99, 235, 0.18);
		color: #dbeafe;
	}

	.about-section {
		padding-block: 110px;
	}

	.about-card {
		display: grid;
		grid-template-columns: 300px minmax(0, 1fr);
		gap: 50px;
		align-items: center;
		padding: 56px;
		border-radius: 24px;
		box-shadow: 0 18px 55px rgba(15, 23, 42, 0.08);
	}

	.about-photo-wrapper {
		position: relative;
		isolation: isolate;
	}

	.about-photo-wrapper::before {
		position: absolute;
		inset: 18px -18px -18px 18px;
		z-index: -1;
		border-radius: 24px;
		background: linear-gradient(135deg, #2563eb, #60a5fa);
		content: "";
	}

	.about-photo {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		border-radius: 24px;
		box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
		object-fit: cover;
		object-position: center;
	}

	.about-content {
		min-width: 0;
	}

	.about-content > p {
		max-width: 760px;
	}

	.about-lead {
		color: #1e293b;
		font-size: 1.18rem;
		font-weight: 650;
		line-height: 1.65;
	}

	.credentials {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
		margin-top: 36px;
	}

	.credentials div {
		display: grid;
		gap: 6px;
		padding: 20px;
		border-radius: 14px;
		background: #f1f5f9;
	}

	.credentials span {
		color: #64748b;
		font-size: 0.9rem;
	}

	.contact-section {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 50px;
		align-items: center;
		margin-bottom: 90px;
		padding: 58px;
		border: 1px solid #dbeafe;
		border-radius: 24px;
		background: #eff6ff;
	}

	.contact-actions {
		justify-content: flex-end;
	}

	a:focus-visible,
	.button:focus-visible {
		outline: 3px solid rgba(37, 99, 235, 0.35);
		outline-offset: 4px;
	}

	@media (max-width: 900px) {
		.hero,
		.intro,
		.contact-section {
			grid-template-columns: 1fr;
		}

		.hero {
			gap: 40px;
			min-height: auto;
			padding-block: 70px;
		}

		.services-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.contact-actions {
			justify-content: flex-start;
		}

		.about-card {
			grid-template-columns: 1fr;
		}

		.about-photo-wrapper {
			max-width: 320px;
		}
	}

	@media (max-width: 650px) {
		.hero,
		.section,
		.ai-section {
			width: min(100% - 28px, 1180px);
		}

		.hero {
			padding-block: 48px;
		}

		.section {
			padding-block: 65px;
		}

		h1 {
			font-size: clamp(2.55rem, 15vw, 4.4rem);
		}

		.services-grid,
		.projects-grid,
		.credentials {
			grid-template-columns: 1fr;
		}

		.project-card.featured {
			grid-row: auto;
			min-height: auto;
		}

		.ai-section,
		.about-card,
		.contact-section {
			padding: 30px 22px;
		}

		.hero-actions,
		.contact-actions {
			flex-direction: column;
		}

		.button {
			width: 100%;
